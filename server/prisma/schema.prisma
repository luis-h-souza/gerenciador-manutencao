generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Loja {
  id           String    @id @default(uuid())
  numero       Int       @unique
  nome         String
  regiao       String
  telefone     String?
  endereco     String?
  ativo        Boolean   @default(true)
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  usuarios     Usuario[]

  @@index([regiao, ativo])
  @@map("lojas")
}

model Usuario {
  id                    String                 @id @default(uuid())
  nome                  String
  email                 String                 @unique
  senha                 String
  role                  Role                   @default(TECNICO)
  ativo                 Boolean                @default(true)
  regiao                String?
  lojaId                String?
  criadoEm              DateTime               @default(now())
  atualizadoEm          DateTime               @updatedAt
  loja                  Loja?                  @relation(fields: [lojaId], references: [id])
  checklistsCarrinho    ChecklistCarrinho[]
  checklistsEquipamento ChecklistEquipamento[]
  ativosLoja            AtivoLoja[]
  notificacoes          Notificacao[]
  refreshTokens         RefreshToken[]
  sessoes               Sessao[]
  tarefasAtribuidas     Tarefa[]               @relation("TarefaAtribuida")
  tarefasCriadas        Tarefa[]               @relation("TarefaCriada")
  logsAuditoria         LogAuditoria[]
  falhasResolvidas      RegistroFalhaAtivo[]   @relation("FalhaResolvidaPor")
  rotinasInfra          ChecklistRotinaInfra[] @relation("RotinaInfraCriadaPor")

  @@map("usuarios")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  usuarioId String
  expiresAt DateTime
  revogado  Boolean  @default(false)
  criadoEm  DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiresAt, revogado])
  @@map("refresh_tokens")
}

model Sessao {
  id        String   @id @default(uuid())
  sessionId String   @unique
  usuarioId String
  ipAddress String?
  userAgent String?
  ativo     Boolean  @default(true)
  expiresAt DateTime
  criadoEm  DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiresAt, ativo])
  @@map("sessoes")
}

model Tarefa {
  id              String           @id @default(uuid())
  descricao       String
  prioridade      PrioridadeTarefa @default(MEDIA)
  status          StatusTarefa     @default(PENDENTE)
  areResponsavel  String
  regiao          String?
  unidade         String?
  dataConclusao   DateTime?
  criadoPorId     String
  atribuidoParaId String?
  criadoEm        DateTime         @default(now())
  atualizadoEm    DateTime         @updatedAt
  notificacoes    Notificacao[]
  atribuidoPara   Usuario?         @relation("TarefaAtribuida", fields: [atribuidoParaId], references: [id])
  criadoPor       Usuario          @relation("TarefaCriada", fields: [criadoPorId], references: [id])

  @@index([atribuidoParaId])
  @@index([regiao, status])
  @@index([criadoEm])
  @@map("tarefas")
}

model Notificacao {
  id        String   @id @default(uuid())
  titulo    String
  mensagem  String
  lida      Boolean  @default(false)
  tarefaId  String?
  usuarioId String?
  criadoEm  DateTime @default(now())
  tarefa    Tarefa?  @relation(fields: [tarefaId], references: [id])
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, lida])
  @@map("notificacoes")
}

model LogAuditoria {
  id        String   @id @default(uuid())
  usuarioId String
  acao      String
  modulo    String
  detalhes  Json?
  ip        String?
  userAgent String?
  criadoEm  DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([modulo])
  @@index([criadoEm])
  @@map("logs_auditoria")
}

model ControleChamado {
  id              String          @id @default(uuid())
  dataAbertura    DateTime
  numeroChamado   String
  segmento        SegmentoChamado
  empresa         String
  descricao       String
  regiao          String?
  unidade         String?
  numeroOrcamento String?
  solicitacao     String?
  dataAprovacao   DateTime?
  numeroOM        String?
  valor           Decimal?        @db.Decimal(12, 2)
  status          StatusChamado   @default(AGUARDANDO_APROVACAO)
  mauUso          Boolean         @default(false)
  ativoId         String?
  ativo           AtivoLoja?      @relation(fields: [ativoId], references: [id])
  dataResolucao   DateTime?
  criadoEm        DateTime        @default(now())
  atualizadoEm    DateTime        @updatedAt

  @@index([regiao, dataAbertura])
  @@index([unidade, dataAbertura])
  @@index([status])
  @@index([segmento])
  @@index([ativoId])
  @@map("controle_chamados")
}

model Fornecedor {
  id           String   @id @default(uuid())
  nome         String
  telefone     String?
  email        String?
  segmento     String
  cnpj         String   @unique
  regiao       String?
  cnae         String?
  descricao    String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([regiao, ativo])
  @@map("fornecedores")
}

model MetaOrcamentaria {
  id           String   @id @default(uuid())
  regiao       String
  unidade      String? // Opcional: meta pode ser por regional ou por loja específica
  ano          Int
  mes          Int
  valorMeta    Decimal  @db.Decimal(12, 2)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([regiao, unidade, ano, mes], name: "meta_unica")
  @@map("metas_orcamentarias")
}

model Peca {
  id                String             @id @default(uuid())
  nome              String
  descricao         String?
  quantidadeEstoque Int                @default(0)
  criadoEm          DateTime           @default(now())
  atualizadoEm      DateTime           @updatedAt
  entradas          EntradaPeca[]
  movimentacoes     MovimentacaoPeca[]
  saidas            SaidaPeca[]

  @@map("pecas")
}

model EntradaPeca {
  id               String   @id @default(uuid())
  pecaId           String
  dataEntrada      DateTime
  quantidade       Int
  valorUnitario    Decimal  @db.Decimal(10, 2)
  fornecedor       String
  numeroNotaFiscal String?
  total            Decimal  @db.Decimal(12, 2)
  criadoEm         DateTime @default(now())
  peca             Peca     @relation(fields: [pecaId], references: [id])

  @@index([pecaId, dataEntrada])
  @@map("entradas_pecas")
}

model MovimentacaoPeca {
  id               String             @id @default(uuid())
  pecaId           String
  dataMovimentacao DateTime
  lojaRequisitante String
  quantidade       Int
  numeroChamado    String?
  status           StatusMovimentacao @default(PENDENTE)
  criadoEm         DateTime           @default(now())
  peca             Peca               @relation(fields: [pecaId], references: [id])

  @@index([pecaId, status])
  @@map("movimentacoes_pecas")
}

model SaidaPeca {
  id          String   @id @default(uuid())
  pecaId      String
  data        DateTime
  quantidade  Int      @default(1)
  destino     String
  nomeRetirou String
  empresa     String
  criadoEm    DateTime @default(now())
  peca        Peca     @relation(fields: [pecaId], references: [id])

  @@index([pecaId])
  @@map("saidas_pecas")
}

model ChecklistEquipamento {
  id           String                     @id @default(uuid())
  semana       Int
  ano          Int
  regiao       String
  unidade      String
  criadoPorId  String
  observacoes  String?
  criadoEm     DateTime                   @default(now())
  atualizadoEm DateTime                   @updatedAt
  itens        ChecklistEquipamentoItem[]
  criadoPor    Usuario                    @relation(fields: [criadoPorId], references: [id])

  @@unique([semana, ano, unidade], name: "semana_ano_unidade")
  @@index([regiao, ano])
  @@map("checklists_equipamento")
}

model ChecklistEquipamentoItem {
  id                 String               @id @default(uuid())
  checklistId        String
  tipoEquipamento    TipoEquipamento? // nullable: itens dinâmicos via ativos não usam enum
  nomeEquipamento    String? // nome livre do ativo (para itens dinâmicos)
  operacional        Boolean              @default(true)
  quantidade         Int                  @default(1)
  quantidadeQuebrada Int                  @default(0)
  numeroSerie        String?
  numeroChamado      String?
  descricaoProblema  String?
  valor              Decimal?             @db.Decimal(12, 2)
  ativoId            String? // Vínculo com AtivoLoja (obrigatório nos itens dinâmicos)
  checklist          ChecklistEquipamento @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  ativo              AtivoLoja?           @relation(fields: [ativoId], references: [id])

  @@map("checklist_equipamento_itens")
}

model ChecklistCarrinho {
  id           String                  @id @default(uuid())
  semana       Int
  ano          Int
  regiao       String
  unidade      String
  criadoPorId  String
  observacoes  String?
  criadoEm     DateTime                @default(now())
  atualizadoEm DateTime                @updatedAt
  itens        ChecklistCarrinhoItem[]
  criadoPor    Usuario                 @relation(fields: [criadoPorId], references: [id])

  @@unique([semana, ano, unidade], name: "semana_ano_unidade")
  @@index([regiao, ano])
  @@map("checklists_carrinho")
}

model ChecklistCarrinhoItem {
  id                String            @id @default(uuid())
  checklistId       String
  tipoCarrinho      TipoCarrinho
  total             Int               @default(0)
  quebrados         Int               @default(0)
  numeroChamado     String?
  descricaoProblema String?
  checklist         ChecklistCarrinho @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@map("checklist_carrinho_itens")
}

model FrotaCarrinho {
  id           String       @id @default(uuid())
  unidade      String
  tipoCarrinho TipoCarrinho
  total        Int          @default(0)
  atualizadoEm DateTime     @updatedAt

  @@unique([unidade, tipoCarrinho])
  @@map("frota_carrinhos")
}

model AtivoLoja {
  id           String   @id @default(uuid())
  nome         String
  categoria    String
  tipo         String?
  fabricante   String?
  modelo       String?
  numeroSerie  String?
  patrimonio   String?
  quantidade   Int      @default(1)
  status       String   @default("ATIVO")
  localizacao  String?
  observacoes  String?
  regiao       String
  unidade      String
  criadoPorId  String
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // Campos de infraestrutura (preventiva e baterias)
  ultimaPreventiva    DateTime?
  proximaPreventiva   DateTime?
  ultimaTrocaBateria  DateTime?
  proximaTrocaBateria DateTime?
  intervaloPreventiva Int? // em dias (ex: 180 = semestral; null = sem preventiva)

  // Dados técnicos flexíveis por categoria (Json)
  dadosTecnicos Json?

  criadoPor      Usuario                    @relation(fields: [criadoPorId], references: [id])
  falhas         RegistroFalhaAtivo[]
  checklistItens ChecklistEquipamentoItem[]
  chamados       ControleChamado[]
  valorSubstituicao Decimal?                 @db.Decimal(12, 2)

  @@index([regiao])
  @@index([unidade])
  @@index([categoria])
  @@index([status])
  @@index([ativo])
  @@map("ativos_loja")
}

model RegistroFalhaAtivo {
  id              String    @id @default(uuid())
  ativoId         String
  dataDeteccao    DateTime // Data do checklist que detectou a falha
  dataResolucao   DateTime? // Preenchido via checklist (auto) ou "Marcar Resolvido" (manual)
  origemResolucao String? // "CHECKLIST" ou "MANUAL"
  descricao       String // Descrição do problema observado
  reincidencia    Boolean   @default(false) // True se mesmo tipo de problema em < 90 dias
  horasParada     Float?    // Novo: para Uptime e Custo/Hora de Parada
  chamadoId       String? // Vínculo com ControleChamado (rastreabilidade financeira)
  resolvidoPorId  String? // Quem marcou como resolvido (se manual)
  criadoEm        DateTime  @default(now())
  ativo           AtivoLoja @relation(fields: [ativoId], references: [id])
  resolvidoPor    Usuario?  @relation("FalhaResolvidaPor", fields: [resolvidoPorId], references: [id])

  @@index([ativoId, dataDeteccao])
  @@index([ativoId, dataResolucao])
  @@map("registros_falha_ativos")
}

model ChecklistRotinaInfra {
  id                  String          @id @default(uuid())
  tipo                TipoRotinaInfra
  regiao              String
  unidade             String
  semana              Int? // Semana ISO — apenas para GERADOR_SEMANAL
  mes                 Int
  ano                 Int
  conforme            Boolean
  descricao           String? // Obrigatório se conforme = false
  preenchidoEm        DateTime        @default(now())
  preenchidoComAtraso Boolean         @default(false)
  dataLimite          DateTime // Calculada automaticamente pelo backend
  criadoPorId         String
  ativoId             String? // Gerador ou sistema de incêndio relacionado
  criadoPor           Usuario         @relation("RotinaInfraCriadaPor", fields: [criadoPorId], references: [id])

  @@unique([tipo, unidade, semana, mes, ano], name: "rotina_unica")
  @@index([unidade, mes, ano])
  @@index([regiao, mes, ano])
  @@index([tipo, mes, ano])
  @@map("checklists_rotina_infra")
}

enum TipoRotinaInfra {
  GERADOR_SEMANAL
  INCENDIO_MENSAL_VISUAL
  INCENDIO_BIMESTRAL_BOMBA
}

enum Role {
  ADMINISTRADOR
  DIRETOR
  GERENTE
  COORDENADOR
  GESTOR
  TECNICO
}

enum PrioridadeTarefa {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum StatusTarefa {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum SegmentoChamado {
  AR_CONDICIONADO
  CARRINHO_CLIENTE
  CARRO_PIPA
  LIMPEZA_ESGOTO
  CIVIL
  COZINHA_REFEITORIO
  ELETRICA
  TRANSPALETEIRA
  EMPILHADEIRA
  GERADOR
  HIDRAULICA
  LAUDOS
  NOBREAK
  MATERIAL_MANUTENCAO
  PINTURA
  REFRIGERACAO
  REFRIGERACAO_PECAS
  SERRALHERIA
  SISTEMA_INCENDIO
  LOCACAO
  LIMPEZA
  TRATAMENTO_AGUA
  PORTA_PALETES
  FERRAMENTAS
  COMUNICACAO_VISUAL
  ELEVADORES
  ESTEIRAS
  TELHADO
  CHECKOUT
  VIDRACARIA
  FATIADORA
  SERRA_FITA
  EMBALADORA
  MAQUINA_VACUO
  LAVA_LOUCA
  CAFETERIA
  SISTEMA_SOM
  FRENTE_CAIXA
  GALERIAS
  FRETE
  OUTROS
}

enum StatusChamado {
  AGUARDANDO_APROVACAO
  AGUARDANDO_OM_ENTREGA
  FINALIZADO
  ALUGUEL_OUTROS
}

enum StatusMovimentacao {
  PENDENTE
  ENVIADO
  RECEBIDO
  CANCELADO
}

enum TipoEquipamento {
  EMPILHADEIRA_ELETRICA
  EMPILHADEIRA_COMBUSTAO
  EMPILHADEIRA_PATOLADA
  MAQUINA_MOER_CARNE
  SERRA_FITA
  EMBALADORA_VACUO
  FATIADORA
  FATIADORA_GRANDE
  ELEVADOR
  ILHASELF
  ESCADA_ROLANTE
}

enum TipoCarrinho {
  MARIA_GORDA
  SUPERCAR
  DOIS_ANDARES
  PRANCHA
  PRANCHA_PERECIVEIS
  CARRINHO_ABASTECIMENTO
  ESCADA
  BEBE_CONFORTO
  CARRINHO_MOTORIZADO
  ESCADA_ABASTECIMENTO
}
